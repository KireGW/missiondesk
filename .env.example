OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISSIONDESK_PROCESSING_MODEL=gpt-6-luna
MISSIONDESK_BRIEFING_MODEL=gpt-6.1-sol
MISSIONDESK_AI_LIMIT=10

# Leave legacy enabled on the existing installation. Personal mode is opt-in per deployment.
MISSIONDESK_ACCESS_MODE=legacy
# Online personal pilot: true only on its separate project; approved managed accounts only.
MISSIONDESK_PILOT_INVITE_ONLY=false
MISSIONDESK_WORKSPACE_PILOT=false
MISSIONDESK_WORKSPACE_REFRESH=false
# Personal mode: a separately configured Auth0 Regular Web Application (not embassy SSO).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=
# Optional closed Auth0 database connection; email-free access also requires an administrator-approved database record.
MISSIONDESK_USERNAME_CONNECTION=
